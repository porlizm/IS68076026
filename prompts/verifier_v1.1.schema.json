{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verifier_v1.1.schema.json",
  "title": "ผลตอบกลับของโมเดลตรวจความเกี่ยวข้อง (R3b) ตาม prompt verifier_v1.1 · ตรวจด้วย engine.parseVerifierOutput (รับ verifier_v1.0 ได้)",
  "type": "object",
  "required": [
    "schema_version",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "verifier_v1.1",
        "verifier_v1.0"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "verdict"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^c\\d{3}$"
          },
          "verdict": {
            "enum": [
              "supports",
              "partially_supports",
              "unrelated"
            ]
          }
        }
      }
    }
  },
  "x-on-invalid": "ข้อที่ไม่มีคำตอบที่ถูกต้อง = R3b_unavailable → เสียง unverified (ไม่นับใน R1)"
}
