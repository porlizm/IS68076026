# env_template.env — คัดลอกเป็น .env (ห้าม commit .env) · ใช้กับ n8n 2.39.9 / Node 24
# อ่านวิธีตั้งค่าทีละขั้นใน docs/Setup_Guide.md

# --- n8n ---
N8N_BLOCK_ENV_ACCESS_IN_NODE=false          # Code node ต้องอ่าน MODEL_*_ID และคีย์ได้ (ตาราง 3.8)
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
GENERIC_TIMEZONE=Asia/Bangkok
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=2160                # 90 วัน (ชั่วโมง) ให้ตรงระยะเก็บข้อมูลใน 3.10

# --- โมเดล (ตารางที่ 3.8) ---
MODEL_A_ID=
MODEL_B_ID=
MODEL_C_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- บริการอ่านข้อความ ---
GCP_PROJECT_ID=
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=
LOCAL_OCR_URL=http://localhost:8884/ocr     # บริการสำรอง (ยังไม่ได้ตั้งค่า)

# --- Google Workspace ---
SHEET_ID=
DRIVE_FORM_FOLDER_ID=
DRIVE_REPORT_FOLDER_ID=
DRIVE_MASKED_TEXT_FOLDER_ID=
RESEARCHER_EMAIL=
